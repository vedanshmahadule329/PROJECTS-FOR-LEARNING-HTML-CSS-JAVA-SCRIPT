```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Password Strength Checker</title>

<style>
*{box-sizing:border-box;margin:0;padding:0;font-family:Arial}

body{
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:#0f172a;
    color:white;
}

.card{
    width:380px;
    padding:30px;
    border-radius:20px;
    background:#1e293b;
    box-shadow:0 20px 50px #0006;
}

h1{text-align:center;margin-bottom:10px}
p{text-align:center;color:#94a3b8;margin-bottom:25px}

input{
    width:100%;
    padding:14px;
    border:1px solid #475569;
    border-radius:10px;
    outline:none;
    background:#0f172a;
    color:white;
    font-size:16px;
}

.bar{
    height:8px;
    margin:15px 0;
    border-radius:10px;
    background:#334155;
    overflow:hidden;
}

#strength{
    width:0;
    height:100%;
    transition:.3s;
}

#text{text-align:center;font-weight:bold;margin-bottom:20px}

ul{list-style:none;line-height:2;color:#94a3b8}
</style>
</head>

<body>

<div class="card">
    <h1>🔐 Password Checker</h1>
    <p>Create a strong password</p>

    <input type="password" id="password" placeholder="Enter password">

    <div class="bar">
        <div id="strength"></div>
    </div>

    <div id="text">Enter password</div>

    <ul>
        <li id="length">❌ 8+ characters</li>
        <li id="upper">❌ Uppercase letter</li>
        <li id="number">❌ Number</li>
        <li id="special">❌ Special character</li>
    </ul>
</div>

<script>
const password = document.getElementById("password");

password.addEventListener("input", () => {
    let p = password.value, score = 0;

    if(p.length >= 8) score++;
    if(/[A-Z]/.test(p)) score++;
    if(/[0-9]/.test(p)) score++;
    if(/[^A-Za-z0-9]/.test(p)) score++;

    document.getElementById("length").textContent =
        `${p.length >= 8 ? "✅" : "❌"} 8+ characters`;

    document.getElementById("upper").textContent =
        `${/[A-Z]/.test(p) ? "✅" : "❌"} Uppercase letter`;

    document.getElementById("number").textContent =
        `${/[0-9]/.test(p) ? "✅" : "❌"} Number`;

    document.getElementById("special").textContent =
        `${/[^A-Za-z0-9]/.test(p) ? "✅" : "❌"} Special character`;

    const bar = document.getElementById("strength");
    const text = document.getElementById("text");

    bar.style.width = score * 25 + "%";

    if(score <= 1){
        text.textContent = "Weak Password 🔴";
        bar.style.background = "#ef4444";
    }else if(score <= 3){
        text.textContent = "Medium Password 🟡";
        bar.style.background = "#f59e0b";
    }else{
        text.textContent = "Strong Password 🟢";
        bar.style.background = "#22c55e";
    }
});
</script>

</body>
</html>
```
