<!DOCTYPE html>
<html>
<head>
  <title>Mood Switcher</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    body{
      font-family:Arial;
      height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      background:#111827;
      color:white;
      transition:.5s;
    }
    .box{
      text-align:center;
      padding:40px;
      width:350px;
      border-radius:20px;
      background:#ffffff20;
      backdrop-filter:blur(10px);
      box-shadow:0 10px 30px #0005;
    }
    h1{font-size:32px;margin-bottom:10px}
    #emoji{font-size:65px;margin:20px}
    #msg{margin-bottom:25px;color:#ddd}
    button{
      border:0;
      padding:12px 16px;
      margin:5px;
      border-radius:10px;
      cursor:pointer;
      font-size:15px;
      transition:.2s;
    }
    button:hover{transform:scale(1.08)}
  </style>
</head>

<body>
  <div class="box">
    <h1>Mood Switcher</h1>
    <div id="emoji">😐</div>
    <p id="msg">How are you feeling today?</p>

    <button onclick="mood('happy')">😄 Happy</button>
    <button onclick="mood('chill')">😎 Chill</button>
    <button onclick="mood('focus')">🤓 Focus</button>
    <button onclick="mood('energy')">⚡ Energy</button>
  </div>

  <script>
    function mood(type){
      let data = {
        happy:["😄","Feeling Happy! Keep smiling.","#f59e0b"],
        chill:["😎","Relax and enjoy the moment.","#0891b2"],
        focus:["🤓","Stay focused. You got this!","#4f46e5"],
        energy:["⚡","Let's make something amazing!","#dc2626"]
      };

      emoji.innerText = data[type][0];
      msg.innerText = data[type][1];
      document.body.style.background = data[type][2];
    }
  </script>
</body>
</html>
