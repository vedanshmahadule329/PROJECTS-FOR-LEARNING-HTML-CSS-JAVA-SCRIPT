```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Modern Quiz App</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial;background:#0f172a;color:white;display:grid;place-items:center;min-height:100vh}
.quiz{width:90%;max-width:500px;background:#1e293b;padding:30px;border-radius:20px;box-shadow:0 10px 30px #0005}
h1{text-align:center;margin-bottom:25px}
#question{margin-bottom:20px}
.option{width:100%;padding:14px;margin:8px 0;border:0;border-radius:10px;background:#334155;color:white;text-align:left;cursor:pointer;font-size:15px}
.option:hover{background:#475569}
#next{width:100%;padding:13px;border:0;border-radius:10px;background:#38bdf8;font-weight:bold;cursor:pointer;margin-top:15px}
#score{text-align:center;margin-top:20px;color:#38bdf8;font-weight:bold}
</style>
</head>
<body>

<div class="quiz">
  <h1>🧠 Quiz App</h1>
  <h3 id="question"></h3>
  <div id="options"></div>
  <button id="next">Next Question</button>
  <p id="score"></p>
</div>

<script>
const quiz=[
 {q:"HTML stands for?",o:["Hyper Text Markup Language","High Text Machine Language","Hyper Tool Multi Language"],a:0},
 {q:"Which language styles a webpage?",o:["HTML","CSS","Python"],a:1},
 {q:"Which is used for web logic?",o:["JavaScript","CSS","SQL"],a:0},
 {q:"Which tag creates a link?",o:["<p>","<a>","<h1>"],a:1}
];

let i=0,score=0;
const q=document.getElementById("question"),
opt=document.getElementById("options"),
next=document.getElementById("next");

function show(){
 q.textContent=`${i+1}. ${quiz[i].q}`;
 opt.innerHTML="";
 quiz[i].o.forEach((x,n)=>{
  let b=document.createElement("button");
  b.className="option"; b.textContent=x;
  b.onclick=()=>check(n);
  opt.appendChild(b);
 });
}

function check(n){
 document.querySelectorAll(".option").forEach((b,j)=>{
  b.disabled=true;
  if(j===quiz[i].a)b.style.background="#16a34a";
  if(j===n&&n!==quiz[i].a)b.style.background="#dc2626";
 });
 if(n===quiz[i].a)score++;
}

next.onclick=()=>{
 i++;
 if(i<quiz.length) show();
 else{
  q.textContent="🎉 Quiz Completed!";
  opt.innerHTML="";
  next.style.display="none";
  document.getElementById("score").textContent=`Your Score: ${score}/${quiz.length}`;
 }
};
show();
</script>

</body>
</html>
```
