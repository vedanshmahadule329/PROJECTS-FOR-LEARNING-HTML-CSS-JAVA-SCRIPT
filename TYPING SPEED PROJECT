<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Typing Speed Test</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:Arial,sans-serif;background:#0f172a;color:white;
  min-height:100vh;display:flex;justify-content:center;align-items:center;
}
.box{
  width:90%;max-width:650px;background:#1e293b;padding:30px;
  border-radius:18px;text-align:center;box-shadow:0 10px 30px #0005;
}
h1{margin-bottom:20px}
#text{
  background:#334155;padding:18px;border-radius:10px;
  line-height:1.6;margin-bottom:15px;color:#cbd5e1;
}
textarea{
  width:100%;height:120px;padding:15px;border:0;border-radius:10px;
  outline:none;font-size:16px;resize:none;
}
.stats{
  display:flex;justify-content:space-around;margin:20px 0;
  font-size:18px;
}
button{
  padding:12px 25px;border:0;border-radius:8px;
  background:#38bdf8;color:#082f49;font-weight:bold;cursor:pointer;
}
button:hover{opacity:.8}
</style>
</head>

<body>

<div class="box">
  <h1>⌨️ Typing Speed Test</h1>

  <div id="text">Click Start and begin typing this sentence...</div>

  <textarea id="input" placeholder="Start typing here..." disabled></textarea>

  <div class="stats">
    <span>⏱️ <b id="time">30</b>s</span>
    <span>⚡ <b id="wpm">0</b> WPM</span>
    <span>🎯 <b id="accuracy">100</b>%</span>
  </div>

  <button onclick="startTest()">Start Test</button>
</div>

<script>
const sentences = [
  "Practice makes a programmer better every single day.",
  "Learning JavaScript is fun and powerful.",
  "Consistency is the key to becoming a great developer."
];

let time = 30, timer, started = false;

function startTest(){
  clearInterval(timer);
  time = 30;
  started = true;

  document.getElementById("time").textContent = time;
  document.getElementById("wpm").textContent = 0;
  document.getElementById("accuracy").textContent = 100;

  document.getElementById("text").textContent =
    sentences[Math.floor(Math.random()*sentences.length)];

  let input = document.getElementById("input");
  input.value = "";
  input.disabled = false;
  input.focus();

  timer = setInterval(() => {
    time--;
    document.getElementById("time").textContent = time;
    calculate();

    if(time <= 0){
      clearInterval(timer);
      input.disabled = true;
      started = false;
    }
  },1000);
}

function calculate(){
  let input = document.getElementById("input").value;
  let target = document.getElementById("text").textContent;

  let correct = 0;

  for(let i=0;i<input.length;i++)
    if(input[i] === target[i]) correct++;

  let accuracy = input.length
    ? Math.round((correct/input.length)*100) : 100;

  let minutes = (30-time)/60;
  let words = input.trim().split(/\s+/).filter(Boolean).length;
  let wpm = minutes ? Math.round(words/minutes) : 0;

  document.getElementById("accuracy").textContent = accuracy;
  document.getElementById("wpm").textContent = wpm;
}

document.getElementById("input").addEventListener("input", calculate);
</script>

</body>
</html>
