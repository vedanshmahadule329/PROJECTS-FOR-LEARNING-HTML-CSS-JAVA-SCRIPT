<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mini Shop</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial}
body{background:#f4f4f4;padding:20px}
h1{text-align:center;margin-bottom:20px}
.products{display:flex;gap:20px;justify-content:center;flex-wrap:wrap}
.card{background:#fff;padding:15px;border-radius:10px;box-shadow:0 2px 8px #ccc;text-align:center;width:220px}
.card img{width:100%;height:160px;object-fit:cover;border-radius:8px}
button{padding:8px 15px;background:#007bff;color:#fff;border:none;border-radius:5px;cursor:pointer;margin-top:10px}
button:hover{background:#0056b3}
.cart{background:#fff;margin-top:30px;padding:20px;border-radius:10px;max-width:500px;margin-left:auto;margin-right:auto}
.cart h2{text-align:center}
#items p{display:flex;justify-content:space-between;margin:8px 0}
.total{text-align:right;font-weight:bold;margin-top:10px}
</style>
</head>
<body>

<h1>🛍 Mini Shopping Cart</h1>

<div class="products">

<div class="card">
<img src="https://picsum.photos/300/200?1">
<h3>Headphone</h3>
<p>₹999</p>
<button onclick="add('Headphone',999)">Add to Cart</button>
</div>

<div class="card">
<img src="https://picsum.photos/300/200?2">
<h3>Smart Watch</h3>
<p>₹1999</p>
<button onclick="add('Smart Watch',1999)">Add to Cart</button>
</div>

<div class="card">
<img src="https://picsum.photos/300/200?3">
<h3>Keyboard</h3>
<p>₹1499</p>
<button onclick="add('Keyboard',1499)">Add to Cart</button>
</div>

</div>

<div class="cart">
<h2>🛒 Cart</h2>
<div id="items"></div>
<div class="total">Total: ₹<span id="total">0</span></div>
</div>

<script>
let cart=[],total=0;

function add(name,price){
cart.push({name,price});
total+=price;
show();
}

function remove(i){
total-=cart[i].price;
cart.splice(i,1);
show();
}

function show(){
let data="";
cart.forEach((item,i)=>{
data+=`<p>${item.name} - ₹${item.price}
<button onclick="remove(${i})">❌</button></p>`;
});
document.getElementById("items").innerHTML=data||"<p>Cart Empty</p>";
document.getElementById("total").innerText=total;
}
</script>

</body>
</html>
