<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Profile Card</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:linear-gradient(135deg,#74ebd5,#9face6);
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.card{
    width:330px;
    background:#fff;
    padding:30px;
    border-radius:20px;
    text-align:center;
    box-shadow:0px 10px 25px rgba(0,0,0,0.2);
    transition:0.4s;
}

.card:hover{
    transform:translateY(-10px);
}

.card img{
    width:130px;
    height:130px;
    border-radius:50%;
    border:4px solid royalblue;
    margin-bottom:15px;
}

.card h2{
    color:#333;
    margin-bottom:8px;
}

.role{
    color:royalblue;
    font-weight:bold;
    margin-bottom:15px;
}

.about{
    color:#555;
    line-height:1.5;
    margin-bottom:20px;
}

.skills{
    margin-bottom:20px;
}

.skills span{
    display:inline-block;
    background:royalblue;
    color:white;
    padding:8px 12px;
    border-radius:20px;
    margin:5px;
    font-size:14px;
}

button{
    width:100%;
    padding:12px;
    border:none;
    border-radius:8px;
    background:royalblue;
    color:white;
    font-size:16px;
    cursor:pointer;
    transition:0.3s;
}

button:hover{
    background:#003fbe;
}

</style>

</head>
<body>

<div class="card">

<img src="https://picsum.photos/200" alt="Profile">

<h2>Vedansh Mahadule</h2>

<p class="role">Frontend Developer</p>

<p class="about">
I am learning HTML, CSS and JavaScript. My goal is to become a Full Stack Web Developer.
</p>

<div class="skills">
<span>HTML</span>
<span>CSS</span>
<span>JavaScript</span>
</div>

<button>Follow Me</button>

</div>

</body>
</html>
