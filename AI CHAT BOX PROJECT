<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Chatbot</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:Arial;background:#0f172a;color:white;
  display:flex;justify-content:center;align-items:center;height:100vh
}
.chat{
  width:380px;height:600px;background:#1e293b;
  border-radius:20px;overflow:hidden;
  box-shadow:0 10px 40px #0008
}
header{
  padding:20px;background:#6366f1;
  display:flex;justify-content:space-between;align-items:center
}
header h2{font-size:20px}
header button{
  border:0;background:#ffffff22;color:white;
  padding:8px 12px;border-radius:8px;cursor:pointer
}
#messages{
  height:480px;padding:20px;overflow-y:auto
}
.msg{
  padding:10px 14px;margin-bottom:12px;
  border-radius:12px;max-width:80%;line-height:1.4
}
.user{background:#6366f1;margin-left:auto}
.bot{background:#334155}
.input{
  display:flex;padding:12px;background:#0f172a
}
input{
  flex:1;padding:12px;border:0;outline:0;
  border-radius:10px;background:#334155;color:white
}
.send{
  margin-left:8px;padding:0 18px;border:0;
  border-radius:10px;background:#6366f1;
  color:white;cursor:pointer
}
</style>
</head>

<body>

<div class="chat">
  <header>
    <h2>🤖 AI Assistant</h2>
    <button onclick="clearChat()">Clear</button>
  </header>

  <div id="messages">
    <div class="msg bot">Hello bhai 👋 Kaise help karu?</div>
  </div>

  <div class="input">
    <input id="text" placeholder="Type a message..."
           onkeydown="if(event.key==='Enter') send()">
    <button class="send" onclick="send()">Send</button>
  </div>
</div>

<script>
const messages = document.getElementById("messages");
const input = document.getElementById("text");

function send(){
  let text = input.value.trim();
  if(!text) return;

  addMessage(text,"user");
  input.value="";

  setTimeout(()=>{
    let reply = getReply(text.toLowerCase());
    addMessage(reply,"bot");
  },600);
}

function addMessage(text,type){
  let div=document.createElement("div");
  div.className="msg "+type;
  div.textContent=text;
  messages.appendChild(div);
  messages.scrollTop=messages.scrollHeight;
}

function getReply(text){
  if(text.includes("hello") || text.includes("hi"))
    return "Hello bhai 👋";
  if(text.includes("project"))
    return "Aaj ka project ready hai 🔥";
  if(text.includes("javascript"))
    return "JavaScript seekh rahe ho, great! 🚀";
  if(text.includes("bye"))
    return "See you bhai 👋";
  return "Interesting! Mujhe aur batao 😎";
}

function clearChat(){
  messages.innerHTML =
    '<div class="msg bot">Chat cleared! 👋</div>';
}
</script>

</body>
</html>
