<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pricing Cards</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}
body{
    background:linear-gradient(135deg,#4facfe,#00f2fe);
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
}
.container{
    text-align:center;
}
h1{
    color:#fff;
    margin-bottom:40px;
}
.cards{
    display:flex;
    gap:25px;
    flex-wrap:wrap;
    justify-content:center;
}
.card{
    background:#fff;
    width:280px;
    padding:30px;
    border-radius:15px;
    box-shadow:0 10px 25px rgba(0,0,0,.2);
    transition:.3s;
    position:relative;
}
.card:hover{
    transform:translateY(-12px);
}
.popular{
    position:absolute;
    top:-12px;
    right:20px;
    background:#ff4757;
    color:#fff;
    padding:5px 12px;
    border-radius:20px;
    font-size:13px;
}
.card h2{
    margin-bottom:15px;
}
.price{
    font-size:35px;
    color:#007bff;
    margin:15px 0;
    font-weight:bold;
}
ul{
    list-style:none;
    margin:20px 0;
}
ul li{
    padding:8px 0;
}
button{
    width:100%;
    padding:12px;
    border:none;
    background:#007bff;
    color:#fff;
    border-radius:8px;
    font-size:16px;
    cursor:pointer;
    transition:.3s;
}
button:hover{
    background:#0056b3;
}
@media(max-width:900px){
    .cards{
        flex-direction:column;
        align-items:center;
    }
}
</style>

</head>
<body>

<div class="container">

<h1>Choose Your Plan</h1>

<div class="cards">

<div class="card">
<h2>Basic</h2>
<p class="price">₹199</p>

<ul>
<li>✔ HTML</li>
<li>✔ CSS</li>
<li>✔ Responsive</li>
<li>✖ JavaScript</li>
<li>✖ React</li>
</ul>

<button>Choose Plan</button>

</div>

<div class="card">

<div class="popular">Most Popular</div>

<h2>Pro</h2>
<p class="price">₹499</p>

<ul>
<li>✔ HTML</li>
<li>✔ CSS</li>
<li>✔ JavaScript</li>
<li>✔ Responsive</li>
<li>✖ React</li>
</ul>

<button>Choose Plan</button>

</div>

<div class="card">

<h2>Premium</h2>

<p class="price">₹999</p>

<ul>
<li>✔ HTML</li>
<li>✔ CSS</li>
<li>✔ JavaScript</li>
<li>✔ React</li>
<li>✔ Projects</li>
</ul>

<button>Choose Plan</button>

</div>

</div>

</div>

</body>
</html>
