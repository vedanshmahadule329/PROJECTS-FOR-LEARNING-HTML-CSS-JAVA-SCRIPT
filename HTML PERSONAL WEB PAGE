<!DOCTYPE html>
<html>
<head>
    <title>Basic HTML Example</title>
</head>
<body>

    <h1>My Web Page</h1>
    <p>Welcome to my first HTML page.</p>

    <h2>My Hobbies</h2>
    <ul>
        <li>Reading</li>
        <li>Coding</li>
        <li>Playing Cricket</li>
    </ul>

    <h2>Student Details</h2>
    <table border="1">
        <tr>
            <th>Name</th>
            <th>Age</th>
        </tr>
        <tr>
            <td>Rahul</td>
            <td>20</td>
        </tr>
        <tr>
            <td>Priya</td>
            <td>19</td>
        </tr>
    </table>

    <h2>Contact Form</h2>
    <form>
        Name: <input type="text"><br><br>
        Email: <input type="email"><br><br>
        <input type="submit" value="Submit">
    </form>

</body>
</html>
